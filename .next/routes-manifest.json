{
  "version": 3,
  "pages404": true,
  "appType": "app",
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "priority": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [],
  "onMatchHeaders": [],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/payments/[checkoutId]",
      "regex": "^/api/payments/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPcheckoutId": "nxtPcheckoutId"
      },
      "namedRegex": "^/api/payments/(?<nxtPcheckoutId>[^/]+?)(?:/)?$"
    },
    {
      "page": "/legal/[slug]",
      "regex": "^/legal/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPslug": "nxtPslug"
      },
      "namedRegex": "^/legal/(?<nxtPslug>[^/]+?)(?:/)?$"
    },
    {
      "page": "/shop/[slug]",
