32:["$","section","Why we use it",{"className":"legal-section","id":"3-why-we-use-it","children":[["$","h2",null,{"className":"legal-section__title","children":[3,". ","Why we use it"]}],[["$","p","To process your order, send the e-tickets and the payment confirmation, deliver the products and check the tickets at the entrance — this is needed to perform the contract with you.",{"className":"legal-section__text","children":"To process your order, send the e-tickets and the payment confirmation, deliver the products and check the tickets at the entrance — this is needed to perform the contract with you."}],["$","p","To take the payment and prevent fraud — to perform the contract and in our legitimate interest.",{"className":"legal-section__text","children":"To take the payment and prevent fraud — to perform the contract and in our legitimate interest."}],["$","p","To keep the accounting records and handle returns, refunds and claims — because the law requires it.",{"className":"legal-section__text","children":"To keep the accounting records and handle returns, refunds and claims — because the law requires it."}],["$","p","To answer your messages — at your request.",{"className":"legal-section__text","children":"To answer your messages — at your request."}],["$","p","To send the newsletter and to use analytics and marketing cookies — only with your consent, which you can withdraw at any time.",{"className":"legal-section__text","children":"To send the newsletter and to use analytics and marketing cookies — only with your consent, which you can withdraw at any time."}],["$","p","We do not make decisions about you by automated means only and do not build profiles that have legal effects for you.",{"className":"legal-section__text","children":"We do not make decisions about you by automated means only and do not build profiles that have legal effects for you."}]]]}]
33:["$","section","Who receives it",{"className":"legal-section","id":"4-who-receives-it","children":[["$","h2",null,{"className":"legal-section__title","children":[4,". ","Who receives it"]}],[["$","p","maib (BC “MAIB” S.A.) — to process card payments and refunds.",{"className":"legal-section__text","children":"maib (BC “MAIB” S.A.) — to process card payments and refunds."}],["$","p","The hosting and e-mail providers of the website — to store the website data and send e-mails.",{"className":"legal-section__text","children":"The hosting and e-mail providers of the website — to store the website data and send e-mails."}],["$","p","The courier — your name, phone number and address, only for merchandise delivery.",{"className":"legal-section__text","children":"The courier — your name, phone number and address, only for merchandise delivery."}],["$","p","Google and the social networks — only if you allow analytics or marketing cookies (see the Cookie Policy).",{"className":"legal-section__text","children":"Google and the social networks — only if you allow analytics or marketing cookies (see the Cookie Policy)."}],["$","p","Public authorities, law enforcement or courts — only where the law requires it.",{"className":"legal-section__text","children":"Public authorities, law enforcement or courts — only where the law requires it."}],["$","p","We do not sell your data. Some of these providers may process data outside the Republic of Moldova (for example, a courier delivering abroad or Google). We use only providers that protect the data under safeguards recognised by Law No. 195/2024, such as standard contractual clauses.",{"className":"legal-section__text","children":"We do not sell your data. Some of these providers may process data outside the Republic of Moldova (for example, a courier delivering abroad or Google). We use only providers that protect the data under safeguards recognised by Law No. 195/2024, such as standard contractual clauses."}]]]}]
