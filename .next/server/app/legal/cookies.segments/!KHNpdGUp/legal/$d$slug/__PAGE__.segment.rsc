12:["$","section","Analytics and marketing",{"className":"legal-section","id":"3-analytics-and-marketing","children":[["$","h2",null,{"className":"legal-section__title","children":[3,". ","Analytics and marketing"]}],[["$","p","Analytics — only if you allow them. Google Analytics shows us how visitors use the website (pages visited, time on the website, the type of device), so we can improve it.",{"className":"legal-section__text","children":"Analytics — only if you allow them. Google Analytics shows us how visitors use the website (pages visited, time on the website, the type of device), so we can improve it."}],["$","p","Marketing — only if you allow them. Google Ads and the social networks measure which ads bring visitors and buyers and show you festival ads on other websites.",{"className":"legal-section__text","children":"Marketing — only if you allow them. Google Ads and the social networks measure which ads bring visitors and buyers and show you festival ads on other websites."}],["$","p","These services are run by Google and the social networks, which may process the data outside the Republic of Moldova under their own privacy policies. If you do not allow these cookies, the website works just the same.",{"className":"legal-section__text","children":"These services are run by Google and the social networks, which may process the data outside the Republic of Moldova under their own privacy policies. If you do not allow these cookies, the website works just the same."}]]]}]
