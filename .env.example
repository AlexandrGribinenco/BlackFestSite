# Card payments through maib e-Commerce Checkout (app/api/payments). On the hosting (Plesk) these go into the Node.js
# app's environment variables (docs/deploy-hostmd.md); locally, copy to .env.local and fill in.
# Never commit the real values: the repository is public.

# maib Checkout credentials. The test ones came from ecom@maib.md and work only with the sandbox;
# the production ones come with the Production Project in maibmerchants.
MAIB_CLIENT_ID=
MAIB_CLIENT_SECRET=
MAIB_SIGNATURE_KEY=
# Sandbox for the test keys; leave it out in production (the default is https://api.maibmerchants.md)
MAIB_API_URL=https://sandbox.maibmerchants.md

# Unlocks /api/admin/refund (refunds until there is an admin page): a long random string, at least 24 characters
ADMIN_TOKEN=

# Public address of the site (the buyer returns to SITE_URL/checkout/result)
SITE_URL=https://example.md
# Public address of this server, if it differs from SITE_URL (maib sends the callback to PAYMENTS_API_URL/api/payments/callback)
# PAYMENTS_API_URL=https://api.example.md
# Sites on another origin allowed to call the payment API, comma-separated (e.g. the GitHub Pages test site)
# PAYMENTS_ALLOWED_ORIGINS=https://alexandrgribinenco.github.io

# Payment confirmation e-mails over SMTP, from a mailbox on the site's domain created in Plesk
# (host.md only allows its own mail server). Without them the e-mail is only logged.
SMTP_HOST=mail.example.md
# 465 (SSL) or 587 (TLS)
SMTP_PORT=465
SMTP_USER=tickets@example.md
SMTP_PASSWORD=
EMAIL_FROM="Black Out Fest <tickets@example.md>"
# Local tests without a mail server: e-mails and their PDF tickets are saved as files in this folder instead
# EMAIL_OUTBOX_DIR=.outbox

# Read by the browser at build time: where the payment API is.
# "" (empty) — the same server as the site; a URL — a separate API server. Leave it out to keep the simulated payment.
# For the hosting it's set by the Build for hosting workflow (the "payments" checkbox), not in Plesk.
# NEXT_PUBLIC_PAYMENTS_API_URL=

# Read at build time (lib/site.ts): the site address for share previews, the sitemap and the canonical links,
# and whether search engines may index the site. The workflows set them; locally it's localhost, not indexed.
# NEXT_PUBLIC_SITE_URL=https://www.example.md
# NEXT_PUBLIC_INDEXABLE=1
