# Card payments through maib e-commerce (app/api/payments). On the hosting (Plesk) these go into the Node.js app's
# environment variables (docs/deploy-hostmd.md); locally, copy to .env.local and fill in.
# Never commit the real values: the repository is public.

# Test or production project credentials from maib (test ones come from ecom@maib.md,
# production ones from the Production Project in maibmerchants)
MAIB_PROJECT_ID=
MAIB_PROJECT_SECRET=
MAIB_SIGNATURE_KEY=
# Optional, the default is https://api.maibmerchants.md/v1
# MAIB_API_URL=

# Public address of the site (the buyer returns to SITE_URL/checkout/result)
SITE_URL=https://example.md
# Public address of this server, if it differs from SITE_URL (maib sends the callback to PAYMENTS_API_URL/api/payments/callback)
# PAYMENTS_API_URL=https://api.example.md
# Sites on another origin allowed to call the payment API, comma-separated (e.g. the GitHub Pages test site)
# PAYMENTS_ALLOWED_ORIGINS=https://alexandrgribinenco.github.io

# Payment confirmation e-mails over SMTP, from a mailbox on the site's domain created in Plesk
# (host.md only allows its own mail server). Without them the e-mail is only logged.
SMTP_HOST=mail.example.md
# 465 (SSL) or 587 (TLS)
SMTP_PORT=465
SMTP_USER=tickets@example.md
SMTP_PASSWORD=
EMAIL_FROM="Black Out Fest <tickets@example.md>"

# Read by the browser at build time: where the payment API is.
# "" (empty) — the same server as the site; a URL — a separate API server. Leave it out to keep the simulated payment.
# For the hosting it's set by the Build for hosting workflow (the "payments" checkbox), not in Plesk.
# NEXT_PUBLIC_PAYMENTS_API_URL=
